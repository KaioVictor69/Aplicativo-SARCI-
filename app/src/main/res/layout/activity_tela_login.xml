<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fundo_cor"
    app:circularflow_radiusInDP="50dp"
    tools:context=".telaLogin">

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText3"
        android:layout_width="325dp"
        android:layout_height="70dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        android:digits="0123456789,."
        android:drawableBottom="@drawable/icone_senha"
        android:hint="Digite sua senha"
        android:inputType="number|numberDecimal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:circularflow_viewCenter="50dp"
        tools:layout_editor_absoluteX="43dp"
        tools:layout_editor_absoluteY="458dp" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/editText2"
        android:layout_width="325dp"
        android:layout_height="70dp"
        android:background="@color/white"
        android:backgroundTint="@color/white"
        android:hint="Digite seu email"
        android:inputType="number|numberDecimal"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:layout_editor_absoluteX="43dp"
        tools:layout_editor_absoluteY="333dp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/detalhe_circular_fundo"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="674dp" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/logo_sarci"
        tools:layout_editor_absoluteX="68dp"
        tools:layout_editor_absoluteY="16dp" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sistema de Ampliação de Recursos do SUAP "
        android:textColor="#FDFDFD"
        android:textSize="12sp"
        android:textStyle="italic"
        tools:layout_editor_absoluteX="88dp"
        tools:layout_editor_absoluteY="230dp" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/btnVoltarFundo"
        app:srcCompat="@drawable/btn_voltar"
        tools:layout_editor_absoluteX="30dp"
        tools:layout_editor_absoluteY="810dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="352dp">

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="409dp"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="444dp">

    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/ManterConectado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:text="Manter-me conectado"
        tools:layout_editor_absoluteX="118dp"
        tools:layout_editor_absoluteY="564dp" />

</androidx.constraintlayout.widget.ConstraintLayout>